# Future ROIの環境設定の例。実値は入れず、空の項目名だけを示す。
# ローカルでは`.env`（Git除外）へコピーして値を入れる。`npm run dev:api`が`.env`を読む。
# Engine単体のtypecheck/test/T-14・Docker検証とFoundation checkには全項目不要。

# APIのDB接続先（必須）。password等を含むためSecretとして扱う。
# ローカルCompose（compose.yaml）のDBへ接続する場合の形式: postgres://futureroi:<LOCAL_DB_PASSWORD>@127.0.0.1:55432/futureroi
# passwordに`%`・`#`・`?`・`@`等を含む場合はURI内でpercent-encodeする（例: `%`→`%25`）か、URIからpasswordを省いて
# PGPASSWORDへ生の値を入れる（pgはURIにpasswordがなければPGPASSWORDを使う）。
DATABASE_URL=

# Composeの開発用PostgreSQLのpassword（必須: compose起動時）。ローカル専用で、本番の値を入れない。
LOCAL_DB_PASSWORD=

# APIの待受（任意）。既定はHOST=127.0.0.1、PORT=3000。コンテナ内では0.0.0.0/8080を既定にしている。
HOST=
PORT=

# ビルド済みSPAのディレクトリ（任意）。設定時はAPIが同一originで配信する。未設定ならAPIだけが起動する。
WEB_DIST=

# ログレベル（任意）。既定はinfo。
LOG_LEVEL=

# Better Auth採択・実装時（#75）のAPI用Secret候補。生成・共有は方式決定後。
BETTER_AUTH_SECRET=

# Better Auth採択・実装時（#75）の公開base URL候補。環境ごとに決める。
BETTER_AUTH_URL=
